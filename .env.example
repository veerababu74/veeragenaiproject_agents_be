# ─── Shared by every project ────────────────────────────────────────────────

# Must be identical to JWT_SECRET in veeragenai_projects_be. This service does
# not sign tokens, it only verifies the cookie that backend already issued.
JWT_SECRET=your-jwt-secret-here

# Allowed CORS origins. FRONTEND_URLS is a comma-separated list of extras.
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=

# Where the per-project SQLite files are written. Blank means ./data
DATA_DIR=
PORT=8004
CLEANUP_INTERVAL_SECONDS=3600
RETENTION_HOURS=48

# One Hugging Face bucket for all projects; each writes under its own prefix.
HUGGINGFACE_TOKEN=
HUGGINGFACE_BUCKET=veera20/veeragenaiproject

# One Pinecone account for all projects; each owns a separate index, because an
# index has a fixed dimension and cannot be shared across embedding models.
PINECONE_API_KEY=


# ─── Per project ────────────────────────────────────────────────────────────
# Anything a single project needs is prefixed with its slug, so adding a
# project never means touching core/config.py. Both of these have sensible
# defaults and only need setting to override them.

SIMPLEAGENT_PINECONE_INDEX=simpleagent-rag
SIMPLEAGENT_STORAGE_PREFIX=simpleagent
